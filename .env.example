# Copy this file to .env and fill in your own values.
# .env itself stays private - it is gitignored on purpose.

# SEC EDGAR requires every downloader to identify itself with a contact email.
EDGAR_USER_AGENT=Your Name you@example.com

# Optional settings (defaults shown):
DATA_DIR=data
COMPANIES_PATH=configs/companies.json
ONTOLOGY_PATH=configs/ontology.json
MAX_EXTRACTION_CALLS=0
LOG_LEVEL=INFO
